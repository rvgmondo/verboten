# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
# .next IS committed so `git pull` deploys a ready-to-run build with no server
# build step (see .cpanel.yml). Only the local build cache is ignored.
/.next/cache/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit only the example and the secret-free production URL)
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# portable runtimes (local dev; binaries + cluster data live in the project)
/vendor/
/.pgdata/

# Payload uploaded media (local disk storage)
/media/

# Local image cache used by the media harvest
/.imgcache/

# OS / editor
Thumbs.db

# deploy bundle (generated artifacts + prod env; never commit)
/deploy/

# Runtime data. The database holds staff password hashes and, once the site has
# taken orders, customer names, addresses, phone numbers and dates of birth.
# It must never travel to the remote. The cPanel deploy excludes it too, so the
# live database is the only copy that matters.
verboten.db
verboten.db-shm
verboten.db-wal
