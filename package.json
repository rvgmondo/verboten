{
  "name": "verboten",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/predb.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "cross-env NODE_OPTIONS=--no-deprecation rimraf .next && next dev -p 3001",
    "prebuild": "node scripts/predb.mjs",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "start:cpanel": "cross-env NODE_OPTIONS=--no-deprecation node server.cjs",
    "lint": "eslint",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-setup.ps1",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-start.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-stop.ps1",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env --import tsx src/seed/index.ts",
    "seed:admin": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env --import tsx src/seed/create-admin.ts",
    "seed:media": "cross-env NODE_OPTIONS=--no-deprecation node --env-file-if-exists=.env --import tsx src/seed/harvest-media.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "next": "15.4.11",
    "payload": "3.88.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "sharp": "0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.11",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
