<item><g:id>verboten-premium-brandy</g:id><g:title>Verboten Premium Brandy</g:title><g:description>A three year South African brandy, finished in French oak casks. Born in Pretoria, made for the world.</g:description><g:link>https://verboten.co.za/shop/verboten-premium-brandy</g:link><g:image_link>https://verboten.co.za/api/media/file/verboten-premium-brandy-batch-no-01-3-year-1.jpg</g:image_link><g:availability>in_stock</g:availability><g:price>450.00 ZAR</g:price><g:brand>Verboten</g:brand><g:condition>new</g:condition><g:mpn>VB-B01-750</g:mpn><g:google_product_category>Food, Beverages &amp; Tobacco &gt; Beverages &gt; Alcoholic Beverages &gt; Liquor &amp; Spirits</g:google_product_category><g:product_type>Bottles</g:product_type><g:age_group>adult</g:age_group><g:shipping><g:country>ZA</g:country><g:service>Courier</g:service><g:price>150.00 ZAR</g:price></g:shipping></item>
