5:["$","main",null,{"className":"mx-auto max-w-3xl px-6 py-16 lg:py-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Brandy and Coke, done properly\",\"description\":\"South Africa's drink deserves better than a warm glass and a guess. The proper brandy and Coke, step by step, and why the brandy matters more than you think.\",\"datePublished\":\"2026-08-15T08:00:00.000Z\",\"dateModified\":\"2026-08-24T11:21:43.005Z\",\"author\":{\"@id\":\"https://verboten.co.za/#organization\"},\"publisher\":{\"@id\":\"https://verboten.co.za/#organization\"},\"mainEntityOfPage\":\"https://verboten.co.za/journal/brandy-and-coke-done-properly\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://verboten.co.za/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Journal\",\"item\":\"https://verboten.co.za/journal\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Brandy and Coke, done properly\",\"item\":\"https://verboten.co.za/journal/brandy-and-coke-done-properly\"}]}"}}],["$","header",null,{"className":"space-y-5","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5 rounded-xs border px-2.5 py-1 text-[0.625rem] font-medium uppercase tracking-[0.18em] border-gold-dim/70 text-gold","children":"Brand stories"}],["$","span",null,{"className":"text-xs text-parch","children":"15 August 2026"}]]}],["$","h1",null,{"className":"font-display text-4xl leading-[1.05] tracking-tight text-bone sm:text-5xl","children":"Brandy and Coke, done properly"}],["$","p",null,{"className":"text-lg leading-relaxed text-parch","children":"South Africa's drink deserves better than a warm glass and a guess. The proper brandy and Coke, step by step, and why the brandy matters more than you think."}]]}],null,["$","div",null,{"className":"space-y-5 text-parch [&_h2]:font-display [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:tracking-tight [&_h2]:text-bone [&_h3]:font-display [&_h3]:pt-2 [&_h3]:text-xl [&_h3]:text-bone [&_strong]:font-semibold [&_strong]:text-bone [&_a]:text-gold [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-gold-bright [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_blockquote]:border-l [&_blockquote]:border-gold-dim [&_blockquote]:pl-5 [&_blockquote]:font-display [&_blockquote]:italic [&_blockquote]:text-bone mt-10 text-base","children":["$","div",null,{"className":"payload-richtext","children":[["$","p","0",{"children":["Brandy and Coke is South Africa's drink. It gets poured at every braai, every match, every family thing, and most of the time it gets poured badly. Warm glass, flat cola, brandy chosen by price alone. The drink deserves better, and so do you."]}],["$","h2","1",{"children":["The rules"]}],["$","p","2",{"children":["Cold everything. The glass from the freezer if you can manage it, the cola from the fridge, never the pantry. Ice first, more than feels polite. Brandy in before the cola so the pour mixes itself. Cola down the side of the glass, slowly, so the bubbles survive. Stir once. Once."]}],["$","h2","3",{"children":["The ratio"]}],["$","p","4",{"children":["One part brandy to two and a half parts cola. Stronger and you lose the refreshment, weaker and you are drinking cola with regrets. Fifty millilitres of brandy to about 120 of cola in a tall glass full of ice is the pour we stand behind."]}],"$L1f","$L20","$L21"]}]}],"$L22"]}]
9:{"metadata":[["$","title","0",{"children":"Brandy and Coke, done properly | Verboten Spirits"}],["$","meta","1",{"name":"description","content":"South Africa's drink deserves better than a warm glass and a guess. The proper brandy and Coke, step by step, and why the brandy matters more than you think."}],["$","link","2",{"rel":"canonical","href":"https://verboten.co.za/journal/brandy-and-coke-done-properly"}],["$","meta","3",{"property":"og:title","content":"Verboten Spirits | Premium South African Brandy"}],["$","meta","4",{"property":"og:description","content":"An independent South African brandy house in Pretoria. Premium brandy, born in South Africa and made for the world."}],["$","meta","5",{"property":"og:site_name","content":"Verboten Spirits"}],["$","meta","6",{"property":"og:locale","content":"en_ZA"}],["$","meta","7",{"property":"og:image:alt","content":"Verboten Spirits journal"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image","content":"https://verboten.co.za/journal/brandy-and-coke-done-properly/opengraph-image-973581?6abfef63073a11da"}],["$","meta","10",{"property":"og:image:width","content":"1200"}],["$","meta","11",{"property":"og:image:height","content":"630"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"Verboten Spirits | Premium South African Brandy"}],["$","meta","15",{"name":"twitter:description","content":"An independent South African brandy house in Pretoria. Premium brandy, born in South Africa and made for the world."}],["$","meta","16",{"name":"twitter:image:alt","content":"Verboten Spirits journal"}],["$","meta","17",{"name":"twitter:image:type","content":"image/png"}],["$","meta","18",{"name":"twitter:image","content":"https://verboten.co.za/journal/brandy-and-coke-done-properly/opengraph-image-973581?6abfef63073a11da"}],["$","meta","19"