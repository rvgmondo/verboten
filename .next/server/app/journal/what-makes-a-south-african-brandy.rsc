5:["$","main",null,{"className":"mx-auto max-w-3xl px-6 py-16 lg:py-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"What makes a South African brandy\",\"description\":\"South African brandy has beaten the big names in blind tastings for years. What makes it different, why the law here is stricter than cognac's, and how to taste the difference.\",\"datePublished\":\"2026-08-20T08:00:00.000Z\",\"dateModified\":\"2026-08-31T07:39:11.116Z\",\"author\":{\"@id\":\"https://verboten.co.za/#organization\"},\"publisher\":{\"@id\":\"https://verboten.co.za/#organization\"},\"mainEntityOfPage\":\"https://verboten.co.za/journal/what-makes-a-south-african-brandy\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://verboten.co.za/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Journal\",\"item\":\"https://verboten.co.za/journal\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"What makes a South African brandy\",\"item\":\"https://verboten.co.za/journal/what-makes-a-south-african-brandy\"}]}"}}],["$","header",null,{"className":"space-y-5","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5 rounded-xs border px-2.5 py-1 text-[0.625rem] font-medium uppercase tracking-[0.18em] border-gold-dim/70 text-gold","children":"Brand stories"}],["$","span",null,{"className":"text-xs text-parch","children":"20 August 2026"}]]}],["$","h1",null,{"className":"font-display text-4xl leading-[1.05] tracking-tight text-bone sm:text-5xl","children":"What makes a South African brandy"}],["$","p",null,{"className":"text-lg leading-relaxed text-parch","children":"South African brandy has beaten the big names in blind tastings for years. What makes it different, why the law here is stricter than cognac's, and how to taste the difference."}]]}],null,["$","div",null,{"className":"space-y-5 text-parch [&_h2]:font-display [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:tracking-tight [&_h2]:text-bone [&_h3]:font-display [&_h3]:pt-2 [&_h3]:text-xl [&_h3]:text-bone [&_strong]:font-semibold [&_strong]:text-bone [&_a]:text-gold [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-gold-bright [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_blockquote]:border-l [&_blockquote]:border-gold-dim [&_blockquote]:pl-5 [&_blockquote]:font-display [&_blockquote]:italic [&_blockquote]:text-bone mt-10 text-base","children":["$","div",null,{"className":"payload-richtext","children":[["$","p","0",{"children":["Here is something most people at the braai do not know: South African law holds brandy to a standard stricter than France holds cognac. Pot-stilled, matured at least three years in oak, nothing rushed. The world's blind tastings have noticed, even when the world's shelves have not caught up yet."]}],["$","h2","1",{"children":["The law is the floor"]}],["$","p","2",{"children":["To call itself South African brandy, the spirit must be distilled from wine and rested in oak for a minimum of three years. That is not marketing. It is the legal floor, and it is why a properly made local brandy drinks smoother than plenty of imports at twice the price."]}],["$","h2","3",{"children":["What oak actually does"]}],["$","p","4",{"children":["Three years in a barrel is where a brandy earns its colour and most of its character. The wood breathes, the spirit rounds, the sharp edges go. A finish in French casks on top of that adds the quiet vanilla and spice you taste at the end of a sip. Time is the one ingredient nobody can fake."]}],"$L21","$L22","$L23"]}]}],"$L24"]}]
9:{"metadata":[["$","title","0",{"children":"What makes a South African brandy | Verboten Spirits"}],["$","meta","1",{"name":"description","content":"South African brandy has beaten the big names in blind tastings for years. What makes it different, why the law here is stricter than cognac's, and how to taste the difference."}],["$","link","2",{"rel":"canonical","href":"https://verboten.co.za/journal/what-makes-a-south-african-brandy"}],["$","meta","3",{"property":"og:title","content":"Verboten Spirits | Premium South African Brandy"}],["$","meta","4",{"property":"og:description","content":"An independent South African brandy house in Pretoria. Premium brandy, born in South Africa and made for the world."}],["$","meta","5",{"property":"og:site_name","content":"Verboten Spirits"}],["$","meta","6",{"property":"og:locale","content":"en_ZA"}],["$","meta","7",{"property":"og:image:alt","content":"Verboten Spirits journal"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image","content":"https://verboten.co.za/journal/what-makes-a-south-african-brandy/opengraph-image-973581?6abfef63073a11da"}],["$","meta","10",{"property":"og:image:width","content":"1200"}],["$","meta","11",{"property":"og:image:height","content":"630"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"Verboten Spirits | Premium South African Brandy"}],["$","meta","15",{"name":"twitter:description","content":"An independent South African brandy house in Pretoria. Premium brandy, born in South Africa and made for the world."}],["$","meta","16",{"name":"twitter:image:alt","content":"Verboten Spirits journal"}],["$","meta","17",{"name":"twitter:image:type","content":"image/png"}],["$","meta","18",{"name":"twitter:image","content":"https://verboten.co.za/journal/what-makes-a-south-african-brandy/opengraph-image-973581?6a