9:{"metadata":[["$","title","0",{"children":"Our Story | Verboten Spirits"}],["$","meta","1",{"name":"description","content":"Pretoria, 2020. Two founders quietly breaking convention, and the conviction that the best traditions often start with someone breaking the rules. The Verboten story."}],["$","link","2",{"rel":"canonical","href":"https://verboten.co.za/story"}],["$","meta","3",{"property":"og:title","content":"Verboten Spirits | Premium South African Brandy"}],["$","meta","4",{"property":"og:description","content":"An independent South African brandy house in Pretoria. Premium brandy, born in South Africa and made for the world."}],["$","meta","5",{"property":"og:site_name","content":"Verboten Spirits"}],["$","meta","6",{"property":"og:locale","content":"en_ZA"}],["$","meta","7",{"property":"og:image:alt","content":"Verboten Spirits, premium South African brandy"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image","content":"https://verboten.co.za/opengraph-image-4usi79?98fae1c618acf42e"}],["$","meta","10",{"property":"og:image:width","content":"1200"}],["$","meta","11",{"property":"og:image:height","content":"630"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"Verboten Spirits | Premium South African Brandy"}],["$","meta","15",{"name":"twitter:description","content":"An independent South African brandy house in Pretoria. Premium brandy, born in South Africa and made for the world."}],["$","meta","16",{"name":"twitter:image:alt","content":"Verboten Spirits, premium South African brandy"}],["$","meta","17",{"name":"twitter:image:type","content":"image/png"}],["$","meta","18",{"name":"twitter:image","content":"https://verboten.co.za/opengraph-image-4usi79?98fae1c618acf42e"}],["$","meta","19",{"name":"twitter:image:width","content":"1200"}],["$","meta","20",{"name":"