{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.verboten.co.za"
        }
      ],
      "destination": "https://verboten.co.za/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/product/:slug",
      "destination": "/shop/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/product(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/product-category/:path*",
      "destination": "/shop",
      "statusCode": 308,
      "regex": "^(?!/_next)/product-category(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/about-us",
      "destination": "/story",
      "statusCode": 308,
      "regex": "^(?!/_next)/about-us(?:/)?$"
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "statusCode": 308,
      "regex": "^(?!/_next)/contact-us(?:/)?$"
    },
    {
      "source": "/verboten-event-hub",
