      "statusCode": 308,
      "regex": "^(?!/_next)/verboten-event-hub(?:/)?$"
    },
    {
      "source": "/my-account",
      "destination": "/account",
      "statusCode": 308,
      "regex": "^(?!/_next)/my-account(?:/)?$"
    },
    {
      "source": "/wishlist",
      "destination": "/shop",
      "statusCode": 308,
      "regex": "^(?!/_next)/wishlist(?:/)?$"
    },
    {
      "source": "/cart",
      "destination": "/shop",
      "statusCode": 308,
      "regex": "^(?!/_next)/cart(?:/)?$"
    },
    {
      "source": "/shop/verboten-premium-brandy-batch-no-01-3-year",
      "destination": "/shop/verboten-premium-brandy",
      "statusCode": 308,
      "regex": "^(?!/_next)/shop/verboten-premium-brandy-batch-no-01-3-year(?:/)?$"
    },
    {
      "source": "/shop/batch-no-01-premium-set-2-bottle",
      "destination": "/shop/verboten-premium-set-2-bottle",
      "statusCode": 308,
      "regex": "^(?!/_next)/shop/batch-no-01-premium-set-2-bottle(?:/)?$"
    },
    {
      "source": "/journal/batch-no-01-is-open",
