# --- Core ---
# Database. Default is SQLite: a single self-contained file, no DB server, so
# the whole site runs on cPanel with nothing external. Leave as-is for that.
# To use Postgres instead, set a postgres:// URL (the app switches adapters
# automatically); the portable local Postgres tooling is under scripts/db-*.ps1.
DATABASE_URI=file:./verboten.db

# Payload auth secret. Generate a long random value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public origin of the site (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# --- First admin user (used once by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@verboten.co.za
ADMIN_PASSWORD=

# --- Email (transactional: order confirmations, shipping, admin alerts) ---
# Leave SMTP_HOST empty in dev: emails are logged to the console instead.
# Resend works via SMTP: host smtp.resend.com, user "resend", pass = API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Verboten Spirits <orders@verboten.co.za>"
# Staff address that receives new-order and contact-form alerts.
ADMIN_NOTIFICATIONS_EMAIL=

# --- PayFast (South African payment gateway) ---
# Sandbox credentials: https://sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Required. Must match the passphrase set in the PayFast dashboard. Without it
# the ITN signature check is not secure, so the app refuses to run PayFast.
PAYFAST_PASSPHRASE=
# "true" uses sandbox.payfast.co.za endpoints; anything else uses live.
PAYFAST_SANDBOX=true
